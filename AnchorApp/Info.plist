<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Anchor</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Anchor deep links -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anchor</string>
			</array>
		</dict>
		<!-- Google Sign-In OAuth redirect.
		     Replace REVERSED_GOOGLE_CLIENT_ID with the reversed form of your
		     iOS Client ID, e.g. com.googleusercontent.apps.123456789-abcdef
		     See AUTH_SETUP.md for full instructions. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>REVERSED_GOOGLE_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- ─── Google Sign-In ─────────────────────────────────────────────────
	     Set GOOGLE_CLIENT_ID to your iOS OAuth 2.0 Client ID.
	     Example: 123456789-abcdef.apps.googleusercontent.com
	     Obtain from: Google Cloud Console → APIs & Services → Credentials
	     See AUTH_SETUP.md for step-by-step instructions.
	     ──────────────────────────────────────────────────────────────────── -->
	<key>GOOGLE_CLIENT_ID</key>
	<string>REPLACE_ME</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>NSFamilyControlsUsageDescription</key>
	<string>Anchor needs Screen Time access to block apps during Anchored Mode.</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
